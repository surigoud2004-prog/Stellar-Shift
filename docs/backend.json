{
  "entities": {
    "HighScore": {
      "title": "High Score",
      "description": "A global leaderboard entry for a player.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "score": { "type": "number" },
        "level": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["uid", "displayName", "score", "level", "timestamp"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Persistent data for a player's identity and progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "avatarId": { "type": "string" },
        "xp": { "type": "number" },
        "totalMatches": { "type": "number" },
        "gamesWon": { "type": "number" },
        "starsCollected": { "type": "number" },
        "allTimeHigh": { "type": "number" },
        "coins": { "type": "number" },
        "currentLevel": { "type": "number" }
      },
      "required": ["uid", "name", "avatarId", "xp"]
    },
    "LoreLog": {
      "title": "Lore Log",
      "description": "A generated lore snippet linked to a game event.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "event": { "type": "string" },
        "snippet": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "event", "snippet", "timestamp"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/leaderboard/{scoreId}": {
      "schema": { "$ref": "#/entities/HighScore" },
      "description": "Collection of global high scores. Requires a composite index on score (desc)."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile data. Rules: Owner-only access."
    },
    "/users/{userId}/logs/{logId}": {
      "schema": { "$ref": "#/entities/LoreLog" },
      "description": "Personal mission lore archive. Rules: Owner-only access."
    }
  }
}
